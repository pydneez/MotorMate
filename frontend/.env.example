# Encrypts NextAuth's own session cookie. Independent of the backend's JWT_SECRET (the
# backend issues its own API token — see CLAUDE.md "Auth architecture"). Generate one
# with `openssl rand -base64 32`; this placeholder is not a working secret.
NEXTAUTH_SECRET="dev-secret-change-me"
NEXTAUTH_URL="http://localhost:3000"

# Base URL of the NestJS backend, including its /v1 prefix. Used by the browser, and by the
# Next.js server unless API_INTERNAL_URL is set.
NEXT_PUBLIC_API_URL="http://localhost:8080/v1"

# Only on AWS, where NEXT_PUBLIC_API_URL is the relative "/v1": how the Next.js server
# reaches the backend (the load balancer). Leave unset locally.
# API_INTERNAL_URL="http://<load balancer>/v1"
