# Read by docker-compose.yml (via ${VAR} substitution) to configure the local
# Postgres/pgAdmin containers. Copy this file to a root .env and fill in real local
# values — `docker compose` reads .env automatically from its own directory.
# These are placeholders, not working credentials — do not reuse them as-is.
POSTGRES_USER="changeme"
POSTGRES_PASSWORD="changeme"
POSTGRES_DB="motormate"
PGADMIN_DEFAULT_EMAIL="dev@motormate.example"
PGADMIN_DEFAULT_PASSWORD="changeme"
