# Read by docker-compose.yml (via ${VAR} substitution) to configure the local Postgres and
# pgAdmin containers. Copy to a root .env — `docker compose` reads it automatically.
#
# These are LOCAL-ONLY development defaults: the database only listens on 127.0.0.1 on
# your own machine, so they work as-is and don't need to be shared or kept secret. Never
# reuse them anywhere else — AWS generates its own (see infra/README.md).
POSTGRES_USER="motormate"
POSTGRES_PASSWORD="motormate_dev_password"
POSTGRES_DB="motormate"

# pgAdmin (optional database browser) at http://localhost:5050
PGADMIN_DEFAULT_EMAIL="dev@motormate.example"
PGADMIN_DEFAULT_PASSWORD="motormate_dev_password"
