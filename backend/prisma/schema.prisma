generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum Role {
  /// Runs the platform (all shops): lists shops, suspends/reactivates them. Belongs to no shop.
  PLATFORM_ADMIN
  ADMIN
  ADVISOR
  MECHANIC
  CUSTOMER
}

enum WorkOrderStatus {
  CHECKED_IN
  DIAGNOSING
  AWAITING_PARTS
  IN_PROGRESS
  QUALITY_CHECK
  COMPLETED
  CANCELLED
}

enum StockMovementReason {
  PURCHASE // stock received from a supplier
  WORK_ORDER // part logged on a work order (negative) or returned from one (positive)
  ADJUSTMENT // manual correction (stocktake, damage, ...)
}

enum InvoiceStatus {
  UNPAID
  PAID
  VOID
}

enum RecommendationStatus {
  OPEN // waiting for its due mileage/date
  REMINDED // reminder email sent, customer hasn't come back yet
  DONE // performed on a later work order
  DISMISSED
}

enum AppointmentStatus {
  REQUESTED
  CONFIRMED
  CHECKED_IN // a WorkOrder was created from it
  COMPLETED // its WorkOrder completed
  CANCELLED
  NO_SHOW
}

enum NotificationType {
  SERVICE_REMINDER
  APPOINTMENT_CONFIRMED
  APPOINTMENT_RESCHEDULED
  APPOINTMENT_CANCELLED
  APPOINTMENT_REMINDER
  INVOICE_ISSUED
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  /// Not sent: no email, or (on AWS) the customer hasn't confirmed their subscription.
  SKIPPED
}

// ─── Shops (one deployment, many shops) ─────────────────────────────────────

/// A shop using MotorMate. Everything a shop owns carries its shopId; the API scopes every
/// query to the signed-in user's shop (backend/src/common/tenancy).
model Shop {
  id       String  @id @default(cuid())
  name     String
  /// One line per row of the printed address.
  address  String
  /// E.164, like customer phones.
  phone    String
  email    String?
  taxId    String
  /// A suspended shop's staff can't sign in and its customers can't book (platform admin).
  isActive Boolean @default(true)

  /// Per-shop numbering: WO-0001 and INV-0001 restart for each shop. Incremented atomically.
  lastWorkOrderNumber Int @default(0)
  lastInvoiceNumber   Int @default(0)

  users          User[]
  customers      Customer[]
  vehicles       Vehicle[]
  workOrders     WorkOrder[]
  invoices       Invoice[]
  inventoryItems InventoryItem[]
  services       ServiceCatalogItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Accounts ────────────────────────────────────────────────────────────────

model User {
  id           String    @id @default(cuid())
  /// One login across all shops.
  email        String    @unique
  passwordHash String
  firstName    String
  lastName     String
  role         Role
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?

  /// Staff belong to one shop; customers and the platform admin to none.
  shop   Shop?   @relation(fields: [shopId], references: [id])
  shopId String?
  /// Customers: the shop they used last, picked again at sign-in.
  lastShopId String?

  /// CUSTOMER users: one Customer record per shop they're linked to.
  customers Customer[]

  assignedWorkOrders WorkOrder[]             @relation("AssignedMechanic")
  createdWorkOrders  WorkOrder[]             @relation("WorkOrderCreatedBy")
  statusChanges      WorkOrderStatusChange[]
  stockMovements     StockMovement[]
  auditLogs          AuditLog[]
  addedServiceItems  ServiceItem[]           @relation("ServiceItemAddedBy")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([shopId])
}

// ─── Customers & vehicles ────────────────────────────────────────────────────

model Customer {
  id        String  @id @default(cuid())
  shop      Shop    @relation(fields: [shopId], references: [id])
  shopId    String
  firstName String
  lastName  String
  /// E.164, e.g. +66812345678 — see normalizeThaiPhone in packages/types.
  phone     String
  /// Optional: walk-in customers may not give one, but reminders need it.
  email     String?
  lineId    String?
  notes     String?

  user   User?   @relation(fields: [userId], references: [id])
  userId String?

  /// Email notifications go through an SNS topic: one subscription per customer, filtered
  /// on their id. Set when subscribed; the customer confirms it once from AWS's email.
  notifySubscriptionArn String?
  /// The email the subscription was made for — a different current email means re-subscribe.
  notifyEmail           String?
  notifyConfirmed       Boolean @default(false)

  vehicles      Vehicle[]
  appointments  Appointment[]
  notifications NotificationLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Unique within a shop: the same person can be a customer of several shops.
  @@unique([shopId, email])
  @@unique([shopId, userId])
  @@index([shopId, phone])
  @@index([lastName, firstName])
}

model Vehicle {
  id         String   @id @default(cuid())
  shop       Shop     @relation(fields: [shopId], references: [id])
  shopId     String
  customer   Customer @relation(fields: [customerId], references: [id])
  customerId String

  /// Unique within a shop: the same car at two shops is two records.
  vin             String
  /// As typed for display, e.g. "1กข 1234".
  plate           String
  /// Plate with spaces/dashes stripped — what search matches on.
  plateNormalized String
  /// Thai province name; a plate is only unique together with its province.
  province        String
  make            String
  model           String
  year            Int
  color           String?
  mileage         Int

  workOrders      WorkOrder[]
  recommendations ServiceRecommendation[]
  appointments    Appointment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([shopId, vin])
  @@index([plateNormalized, province])
  @@index([customerId])
}

// ─── Work orders ─────────────────────────────────────────────────────────────

model WorkOrder {
  id     String @id @default(cuid())
  shop   Shop   @relation(fields: [shopId], references: [id])
  shopId String
  /// Human-facing number, displayed as WO-0001 — per shop, from Shop.lastWorkOrderNumber.
  number Int

  vehicle       Vehicle @relation(fields: [vehicleId], references: [id])
  vehicleId     String
  mileageIn     Int
  complaint     String
  diagnosis     String?
  workPerformed String?
  notes         String?

  status      WorkOrderStatus @default(CHECKED_IN)
  mechanic    User?           @relation("AssignedMechanic", fields: [mechanicId], references: [id])
  mechanicId  String?
  createdBy   User            @relation("WorkOrderCreatedBy", fields: [createdById], references: [id])
  createdById String
  completedAt DateTime?

  statusChanges   WorkOrderStatusChange[]
  serviceItems    ServiceItem[]
  partsUsed       PartUsed[]
  stockMovements  StockMovement[]
  recommendations ServiceRecommendation[] @relation("RecommendedOn")
  fulfilled       ServiceRecommendation[] @relation("FulfilledOn")
  invoice         Invoice?
  appointment     Appointment?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([shopId, number])
  @@index([status])
  @@index([vehicleId])
  @@index([mechanicId])
}

model WorkOrderStatusChange {
  id          String           @id @default(cuid())
  workOrder   WorkOrder        @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  workOrderId String
  /// Null for the initial CHECKED_IN entry.
  fromStatus  WorkOrderStatus?
  toStatus    WorkOrderStatus
  note        String?
  changedBy   User             @relation(fields: [changedById], references: [id])
  changedById String
  createdAt   DateTime         @default(now())

  @@index([workOrderId, createdAt])
}

model ServiceItem {
  id            String              @id @default(cuid())
  workOrder     WorkOrder           @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  workOrderId   String
  description   String
  laborCost     Decimal             @db.Decimal(10, 2)
  /// Set when the line came from the price list; description + laborCost are the snapshot.
  catalogItem   ServiceCatalogItem? @relation(fields: [catalogItemId], references: [id])
  catalogItemId String?
  /// Who added the line (null on lines from before this was recorded).
  addedBy       User?               @relation("ServiceItemAddedBy", fields: [addedById], references: [id])
  addedById     String?
  /// When staff changed a list price on this line: the list price then, and why.
  listPrice     Decimal?            @db.Decimal(10, 2)
  priceReason   String?
  createdAt     DateTime            @default(now())

  @@index([catalogItemId])
}

/// The fixed-price list of routine services (Settings → Services & prices). Never deleted.
model ServiceCatalogItem {
  id        String   @id @default(cuid())
  shop      Shop     @relation(fields: [shopId], references: [id])
  shopId    String
  name      String
  category  String
  /// THB, excl. VAT.
  price     Decimal  @db.Decimal(10, 2)
  /// Customers can pick it when booking.
  bookable  Boolean  @default(true)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  serviceItems        ServiceItem[]
  appointmentServices AppointmentService[]

  @@unique([shopId, name])
}

/// A service picked when booking, with its name and price as they were then.
model AppointmentService {
  id            String             @id @default(cuid())
  appointment   Appointment        @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  appointmentId String
  catalogItem   ServiceCatalogItem @relation(fields: [catalogItemId], references: [id])
  catalogItemId String
  name          String
  price         Decimal            @db.Decimal(10, 2)

  @@unique([appointmentId, catalogItemId])
}

// ─── Inventory ───────────────────────────────────────────────────────────────

model InventoryItem {
  id             String  @id @default(cuid())
  shop           Shop    @relation(fields: [shopId], references: [id])
  shopId         String
  sku            String
  name           String
  category       String
  quantityOnHand Int     @default(0)
  /// What the shop pays the supplier.
  unitCost       Decimal @db.Decimal(10, 2)
  /// What the customer is charged.
  unitPrice      Decimal @db.Decimal(10, 2)
  supplier       String?
  /// Low-stock alert threshold.
  reorderLevel   Int     @default(0)
  isActive       Boolean @default(true)

  partsUsed      PartUsed[]
  stockMovements StockMovement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([shopId, sku])
  @@index([name])
  @@index([category])
}

model PartUsed {
  id              String        @id @default(cuid())
  workOrder       WorkOrder     @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  workOrderId     String
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id])
  inventoryItemId String
  quantity        Int
  /// Price snapshot at the time of use, so later catalog price changes don't alter invoices.
  unitPrice       Decimal       @db.Decimal(10, 2)
  createdAt       DateTime      @default(now())
}

model StockMovement {
  id              String              @id @default(cuid())
  inventoryItem   InventoryItem       @relation(fields: [inventoryItemId], references: [id])
  inventoryItemId String
  /// Signed: negative = stock out, positive = stock in.
  quantityChange  Int
  reason          StockMovementReason
  workOrder       WorkOrder?          @relation(fields: [workOrderId], references: [id])
  workOrderId     String?
  note            String?
  createdBy       User                @relation(fields: [createdById], references: [id])
  createdById     String
  createdAt       DateTime            @default(now())

  @@index([inventoryItemId, createdAt])
}

// ─── Billing ─────────────────────────────────────────────────────────────────

model Invoice {
  id          String        @id @default(cuid())
  shop        Shop          @relation(fields: [shopId], references: [id])
  shopId      String
  /// Human-facing number, displayed as INV-0001 — per shop, from Shop.lastInvoiceNumber.
  number      Int
  workOrder   WorkOrder     @relation(fields: [workOrderId], references: [id])
  workOrderId String        @unique
  subtotal    Decimal       @db.Decimal(10, 2)
  vatRate     Decimal       @default(0.07) @db.Decimal(4, 3)
  vatAmount   Decimal       @db.Decimal(10, 2)
  total       Decimal       @db.Decimal(10, 2)
  status      InvoiceStatus @default(UNPAID)
  /// S3 object key of the generated PDF, once uploaded.
  pdfKey      String?
  issuedAt    DateTime      @default(now())
  paidAt      DateTime?

  @@unique([shopId, number])
}

// ─── Reminders & appointments ────────────────────────────────────────────────

model ServiceRecommendation {
  id            String               @id @default(cuid())
  vehicle       Vehicle              @relation(fields: [vehicleId], references: [id])
  vehicleId     String
  /// The visit where it was recommended.
  workOrder     WorkOrder?           @relation("RecommendedOn", fields: [workOrderId], references: [id])
  workOrderId   String?
  description   String
  /// At least one of dueMileage / dueDate is set (enforced in the service layer).
  dueMileage    Int?
  dueDate       DateTime?
  status        RecommendationStatus @default(OPEN)
  /// The later visit that performed it.
  fulfilledBy   WorkOrder?           @relation("FulfilledOn", fields: [fulfilledById], references: [id])
  fulfilledById String?
  createdById   String
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  notifications NotificationLog[]

  @@index([status, dueDate])
  @@index([vehicleId])
}

model Appointment {
  id          String            @id @default(cuid())
  customer    Customer          @relation(fields: [customerId], references: [id])
  customerId  String
  vehicle     Vehicle           @relation(fields: [vehicleId], references: [id])
  vehicleId   String
  scheduledAt DateTime
  reason      String
  status      AppointmentStatus @default(REQUESTED)
  /// Set on check-in.
  workOrder   WorkOrder?        @relation(fields: [workOrderId], references: [id])
  workOrderId String?           @unique
  createdById String
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  notifications NotificationLog[]
  services      AppointmentService[]

  @@index([scheduledAt])
  @@index([status])
}

model NotificationLog {
  id               String                 @id @default(cuid())
  type             NotificationType
  /// Null when skipped because the customer has no email.
  recipientEmail   String?
  status           NotificationStatus     @default(PENDING)
  error            String?
  subject          String?
  customer         Customer?              @relation(fields: [customerId], references: [id])
  customerId       String?
  recommendation   ServiceRecommendation? @relation(fields: [recommendationId], references: [id])
  recommendationId String?
  appointment      Appointment?           @relation(fields: [appointmentId], references: [id])
  appointmentId    String?
  sentAt           DateTime?
  createdAt        DateTime               @default(now())

  @@index([type, createdAt])
  @@index([customerId])
}

// ─── Audit ───────────────────────────────────────────────────────────────────

model AuditLog {
  id        String   @id @default(cuid())
  actor     User?    @relation(fields: [actorId], references: [id])
  /// Null for system actions (e.g. the reminder Lambda).
  actorId   String?
  /// e.g. "workOrder.statusChanged", "vehicle.mileageCorrected", "user.deactivated"
  action    String
  entity    String
  entityId  String
  /// Before/after values or other context.
  changes   Json?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
}
