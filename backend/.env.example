# Build from the same username/password you put in the root .env, plus the DB name/port
# from docker-compose.yml. This is a placeholder, not a working connection string.
DATABASE_URL="postgresql://name:password@localhost:5433/motormate?schema=public"

# Signs and verifies the API access token issued by POST /auth/login. Independent of the
# frontend's NEXTAUTH_SECRET. Generate a real one with `openssl rand -base64 32`.
JWT_SECRET="dev-secret-change-me"

PORT=8080

# Frontend origin(s) allowed to call the API from the browser, comma-separated.
CORS_ORIGIN="http://localhost:3000"
