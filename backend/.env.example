# Build from the same username/password you put in the root .env, plus the DB name/port
# from docker-compose.yml. This is a placeholder, not a working connection string.
DATABASE_URL="postgresql://name:password@localhost:5433/motormate?schema=public"

# Must match NEXTAUTH_SECRET in frontend/.env — same value, used to verify the session
# JWT that NextAuth (frontend) signs. Generate a real one with `openssl rand -base64 32`.
JWT_SECRET="dev-secret-change-me"

PORT=8080
