# Local development defaults — they work as-is with the root .env.example and
# docker-compose.yml. Never reuse them on AWS (up.sh generates its own; see infra/README.md).

# Must match POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB in the root .env;
# 5433 is the host port docker-compose.yml publishes Postgres on.
DATABASE_URL="postgresql://motormate:motormate_dev_password@localhost:5433/motormate?schema=public"

# Signs and verifies the API access token issued by POST /auth/login. Independent of the
# frontend's NEXTAUTH_SECRET — the two don't need to match. Any value works locally; to
# use a random one: `openssl rand -base64 32`.
JWT_SECRET="dev-secret-change-me"

PORT=8080

# Frontend origin(s) allowed to call the API from the browser, comma-separated.
CORS_ORIGIN="http://localhost:3000"
